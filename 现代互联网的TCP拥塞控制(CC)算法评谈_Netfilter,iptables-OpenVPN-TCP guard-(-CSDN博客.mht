<SPAN class=3D"hljs-comment">/* This is Jacobson's slow start and =
congestion avoidance.=0A=
 * SIGCOMM '88, p. 328.=0A=
 */</SPAN>=0A=
<SPAN class=3D"hljs-keyword">void</SPAN> tcp_reno_cong_avoid(<SPAN =
class=3D"hljs-keyword">struct</SPAN> sock *sk, u32 ack, u32 acked)=0A=
{=0A=
    <SPAN class=3D"hljs-keyword">struct</SPAN> tcp_sock *tp =3D =
tcp_sk(sk);=0A=
=0A=
    <SPAN class=3D"hljs-keyword">if</SPAN> (!tcp_is_cwnd_limited(sk))=0A=
        <SPAN class=3D"hljs-keyword">return</SPAN>;=0A=
=0A=
    <SPAN class=3D"hljs-comment">/* In "safe" area, increase. */</SPAN>=0A=
    <SPAN class=3D"hljs-keyword">if</SPAN> (tcp_in_slow_start(tp)) {=0A=
        acked =3D tcp_slow_start(tp, acked);=0A=
        <SPAN class=3D"hljs-keyword">if</SPAN> (!acked)=0A=
