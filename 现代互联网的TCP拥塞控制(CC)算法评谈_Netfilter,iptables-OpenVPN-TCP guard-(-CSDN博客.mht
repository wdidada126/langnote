    }=0A=
    <SPAN class=3D"hljs-comment">/* In dangerous area, increase slowly. =
*/</SPAN>=0A=
    tcp_cong_avoid_ai(tp, tp-&gt;snd_cwnd, acked);=0A=
}</CODE></PRE>
