@charset "utf-8";

body { margin: 0px; padding: 0px; background: url("img/background.gif"); fo=
nt-family: Arial, Helvetica, sans-serif; color: rgb(102, 102, 102); overflo=
w-x: hidden; }

html { height: 100%; min-height: 100%; background: url("img/background.gif"=
); }

a img { border: none; }

a, a:visited { text-decoration: none; outline: none; }

a:hover { text-decoration: underline; }

p { margin: 0px 0px 1em; padding: 0px; line-height: 250%; }

ul { list-style-type: none; margin: 0px 0px 1em; padding: 0px; line-height:=
 0%; }

ul li { margin: 0px; padding: 0px; line-height: normal; zoom: 1; }

ol { margin: 0px 0px 1em 19px; padding: 0px; }

ol li { padding: 0px 0px 5px; line-height: normal; }

