 0%; }

dl dt, dl dd { margin: 0px; padding: 0px; line-height: normal; zoom: 1; }

dl dt { font-weight: bold; }

form, table, input, textarea, dl, dt, dd { margin: 0px; padding: 0px; }

table { border-collapse: collapse; width: 100%; border: 0px; }

cite { text-align: right; display: block; }

object { display: block; margin: 0px auto; }

.wp-caption-text { text-align: center; }

.alignright { float: right; }

.alignleft { float: left; }

.aligncenter { margin-left: auto; margin-right: auto; }

.centered { margin-left: auto; margin-right: auto; }

.clear { clear: both; }

input[type=3D"text"], input[type=3D"password"], textarea, select { outline:=
 none; }

.post a { text-decoration: underline; }

.post h1, .post h2, .post h3, .post h4, .post h5, .post h6 { line-height: 1=
60%; margin: 0px 0px 10px; }

.post img { height: auto; max-width: 100%; width: auto; }

.post img.centered, div.centered { display: block; margin: 15px auto; }

.post img.aligncenter, div.aligncenter { display: block; margin: 15px auto;=
 }

.post img.alignright, div.alignright { margin: 10px 0px 30px 30px; display:=
 inline; }

.post img.alignleft, div.alignleft { margin: 10px 30px 30px 0px; display: i=
nline; }

.post .wp-caption { background: rgb(40, 40, 40); border: 1px solid rgb(68, =
68, 68); max-width: 96%; padding: 14px 9px 1px; border-radius: 5px; }

.post .wp-caption img { display: block; margin: 0px auto; max-width: 100%; =
}

.post .wp-caption .wp-caption-text { padding: 10px 0px 0px; }

.post table { margin: 0px 0px 1em; }

.post td, .post th { border: 1px solid rgb(204, 204, 204); padding: 15px; }

.post th { background: rgb(238, 238, 238); font-weight: normal; }

blockquote { margin: 0px 0px 1em; padding: 50px 50px 40px; background: rgb(=
254, 254, 254); border-radius: 5px; position: relative; border: 1px solid r=
gb(204, 204, 204); }

blockquote::before { content: "\""; font-style: italic; font-size: 40px; fo=
nt-weight: bold; line-height: 40px; width: 30px; height: 30px; position: ab=
solute; top: 20px; left: 20px; color: rgb(170, 170, 170); }

blockquote::after { content: "\""; font-style: italic; font-size: 40px; fon=
t-weight: bold; text-align: left; line-height: 60px; width: 30px; height: 3=
0px; position: absolute; bottom: 20px; right: 20px; color: rgb(170, 170, 17=
0); }

.post li, .post dt, .post dd { margin: 0px; line-height: 200%; }

.post ul li { background: url("img/bullet1.png") left 0.9em no-repeat; padd=
