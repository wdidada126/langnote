}
.tooltip {
	display: none !important;
}
h3.date {
	text-align: center;
}
#daily {
	padding-right: 5px; padding-left: 5px;
}
footer {
	padding: 15px 0px;
}
.post.detail .view-original {
	display: inline-block;
}
.share-help {
	background: rgb(255, 255, 255); padding: 10px; left: 0px; top: 0px; =
right: 0px; display: none; z-index: 9999;
}
.share-help .help-title {
	line-height: 30px;
}
.share-help a span {
	padding-right: 10px; padding-left: 2px;
}
.share-help a {
