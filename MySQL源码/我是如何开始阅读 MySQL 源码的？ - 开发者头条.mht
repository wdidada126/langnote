header.navbar .nav > li > a.navbar-profile {
	border-bottom-color: currentColor; border-bottom-width: medium; =
border-bottom-style: none;
}
header.navbar .nav > li > a.navbar-profile img {
	border-radius: 100%;
}
#float-left-img {
	top: 80px; text-align: center; right: 15px; color: rgb(51, 51, 51); =
display: block; position: fixed; max-width: 124px;
}
#float-left-img img {
	max-width: 100%;
}
@media all and (max-width:479px) and (min-width:320px)
{
#quick-download {
