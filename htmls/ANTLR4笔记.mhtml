<div class=3D"language-plaintext highlighter-rouge"><div class=3D"highlight=
"><pre class=3D"highlight"><code>//------ Puncuation
call : ID '(' exprList ')' ;
// or define token labels
call : ID LP exprList RP ;
LP   : '(';
RP   : ')';

//------ Keywords
returnStmt : 'return' expr ';' ;

//------ Identifiers
ID : ID_LETTER (ID_LETTER | DIGIT)* ;
fragment ID_LETTER : 'a'..'z' | 'A'..'Z' | '_' ;
fragment DIGIT : '0'..'9';

//------ Numbers
INT   : DIGIT+ ;
FLOAT : DIGIT+ '.' DIGIT*
      | '.' DIGIT+
      ;

//------ Strings
STRING : '"' (ESC | .)*? '"' ;
fragment ESC : '\\' [btnr"\\] ;  // \b, \t, \n, ...

//------ Comments
LINE_COMMENT  : '//' .*? '\n' -&gt; skip;
BLOCK_COMMENT : '/*' .*? '*/' -&gt; skip;

//------ Whitespace
WS : [ \t\n\r]+ -&gt; skip
</code></pre></div></div>

