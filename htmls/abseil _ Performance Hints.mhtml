</summary>

<p>coding.cc</p>
<pre><code class=3D"language-c++">for (int c =3D 0; c &lt; clusters-&gt;siz=
e(); c++) {
  RET_CHECK_OK(DecodeBulkForCluster(...);
}
</code></pre>
<pre><code class=3D"language-c++">struct SubTask {
  absl::Status result;
  absl::Notification done;
};

std::vector&lt;SubTask&gt; tasks(clusters-&gt;size());
for (int c =3D 0; c &lt; clusters-&gt;size(); c++) {
  options_.executor-&gt;Schedule([&amp;, c] {
    tasks[c].result =3D DecodeBulkForCluster(...);
    tasks[c].done.Notify();
