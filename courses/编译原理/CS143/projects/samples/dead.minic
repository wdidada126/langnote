// dead.minic — stage 06（优化）专用实验台：常量折叠 / 复制传播 / 死代码删除。
int id(int v) { return v; }

int main() {
  int x = 2 + 3 * 4;       // 临时量链 t=2,u=3,v=4,v=u*t,... 全部折叠为 14
  int y = x;               // y 只在赋值语句里被定义：DCE 删掉这条 store
  print x;                 // 14
  print id(1 + 1) * 3;     // 调用结果不可折叠（保守），两侧操作数可：6
  int neverUsed = 99;      // 死存储：定义后从未被读，整对指令删除
  return 0;
}
